# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Database
HM_DB_HOST=127.0.0.1
HM_DB_NAME=habitmon_db
HM_DB_USER=your_db_user
HM_DB_PASS=your_db_password

# Token signing secret — generate with: php -r "echo bin2hex(random_bytes(32));"
HM_TOKEN_SECRET=change_me_to_a_random_64_char_hex_string

# Set to "true" only in local development to enable PHP error output
APP_DEBUG=false

# Timezone for date calculations (must match user's locale)
APP_TIMEZONE=Europe/Madrid
